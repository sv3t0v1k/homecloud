[Unit]
Description=HomeCloud TEST update admission; starts one verified UI installation
StartLimitIntervalSec=60
StartLimitBurst=3
# admission.path is a persistent single-slot listener, not an open maintenance
# window. It reacts only to a validated inbox request and starts one install job.
OnSuccess=homecloud-update-install.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/libexec/homecloud/update-admission.py
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/homecloud-update/inbox /var/lib/homecloud-update/status
