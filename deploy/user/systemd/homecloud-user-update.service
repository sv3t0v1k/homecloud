[Unit]
Description=HomeCloud release-channel update installation
StartLimitIntervalSec=60
StartLimitBurst=3
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I -S /usr/local/sbin/homecloud-user-update install
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ReadWritePaths=/var/lib/homecloud-update /etc/homecloud
